#!/bin/bash
# SPDX-License-Identifier: Apache-2.0 WITH Swift-exception
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-all}" in
  all) export RELEASE_CHECK_SCOPE=all ;;
  --quality-check) export RELEASE_CHECK_SCOPE=quality ;;
  --compiler-check) export RELEASE_CHECK_SCOPE=compiler ;;
  *) echo 'Usage: Scripts/check [--quality-check|--compiler-check]' >&2; exit 2 ;;
esac
mkdir -p .build/release-validation
if [ "$RELEASE_CHECK_SCOPE" = all ] || [ "$RELEASE_CHECK_SCOPE" = quality ]; then
  Scripts/verify-public-repository.sh
  Scripts/verify-schema-snapshot.sh
  Scripts/verify-dependency-manifest.py
  Scripts/verify-public-api.py
  xcrun swift-format lint --strict --recursive --configuration .swift-format Package.swift Sources Tests Plugins
  Scripts/verify-documentation.sh
fi
if [ "$RELEASE_CHECK_SCOPE" = all ] || [ "$RELEASE_CHECK_SCOPE" = compiler ]; then
  swift build --force-resolved-versions
  swift test --force-resolved-versions --no-parallel
  Scripts/verify-native-build-and-test.sh
fi
python3 - <<'PY'
import hashlib, json, os, pathlib, platform, subprocess
root = pathlib.Path('.build/release-validation')
result = {key: subprocess.check_output(['git', 'rev-parse', ref], text=True).strip()
          for key, ref in [('commit', 'HEAD'), ('tree', 'HEAD^{tree}')]}
result['scope'] = os.environ['RELEASE_CHECK_SCOPE']
result['os'] = platform.platform()
result['swift'] = subprocess.check_output(['swift', '--version'], text=True).strip()
result['xcode'] = subprocess.check_output(['xcodebuild', '-version'], text=True).strip()
result['sdk'] = subprocess.check_output(['xcrun', '--sdk', 'macosx', '--show-sdk-version'], text=True).strip()
result['validation_script_sha256'] = hashlib.sha256(pathlib.Path('Scripts/check').read_bytes()).hexdigest()
result['checks'] = []
if result['scope'] in ('all', 'quality'):
    result['checks'] += ['repository-hygiene', 'schema-integrity', 'dependency-manifest',
                         'public-api-baseline', 'strict-format', 'docc']
if result['scope'] in ('all', 'compiler'):
    result['checks'] += ['swift-build', 'swift-test', 'native-build-and-test', 'cooperative-pool-tests']
(root / 'provenance.json').write_text(json.dumps(result, indent=2) + '\n')
PY
